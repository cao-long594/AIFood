<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/food_add_page_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="40dp"
            android:paddingEnd="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="172dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="vertical"
                    android:paddingTop="18dp">

                    <TextView
                        android:id="@+id/meal_type_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="食物库"
                        android:textColor="#111111"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="添加食物信息，完善营养数据库"
                        android:textColor="#666666"
                        android:textSize="17sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="166dp"
                    android:layout_height="156dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:alpha="0.88"
                    android:contentDescription="食物插图"
                    android:scaleType="fitEnd"
                    android:src="@drawable/food_add_leaf_illustration" />

                <LinearLayout
                    android:layout_width="74dp"
                    android:layout_height="82dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/food_add_favorite_card_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="收藏"
                        android:src="@drawable/food_add_bookmark_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="收藏"
                        android:textColor="#11A866"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/food_add_main_card_bg"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <TextView
                    style="@style/FoodAddSectionTitle"
                    android:text="基础信息" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1.45"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FoodAddFieldLabel"
                            android:text="食物名称" />

                        <EditText
                            android:id="@+id/et_food_name"
                            style="@style/FoodAddInput"
                            android:hint="请输入"
                            android:inputType="text" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FoodAddFieldLabel"
                            android:text="卡路里" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:background="@drawable/food_add_input_bg">

                            <EditText
                                android:id="@+id/et_calories"
                                style="@style/FoodAddInlineInput"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:paddingEnd="54dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:gravity="center"
                                android:paddingEnd="18dp"
                                android:text="kcal"
                                android:textColor="#666666"
                                android:textSize="16sp" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/FoodAddDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/food_add_table_bg"
                    android:orientation="vertical">

                    <LinearLayout style="@style/FoodAddTableRow">
                        <TextView
                            style="@style/FoodAddTableLabel"
                            android:text="碳水" />
                        <FrameLayout style="@style/FoodAddSmallInputWrap">
                            <EditText
                                android:id="@+id/et_carbs"
                                style="@style/FoodAddInlineInput"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:paddingEnd="46dp" />
                            <TextView
                                style="@style/FoodAddInputUnit"
                                android:text="g" />
                        </FrameLayout>
                    </LinearLayout>

                    <View style="@style/FoodAddRowDivider" />

                    <LinearLayout style="@style/FoodAddTableRow">
                        <TextView
                            style="@style/FoodAddTableLabel"
                            android:text="蛋白" />
                        <FrameLayout style="@style/FoodAddSmallInputWrap">
                            <EditText
                                android:id="@+id/et_protein"
                                style="@style/FoodAddInlineInput"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:paddingEnd="46dp" />
                            <TextView
                                style="@style/FoodAddInputUnit"
                                android:text="g" />
                        </FrameLayout>
                    </LinearLayout>

                    <View style="@style/FoodAddRowDivider" />

                    <LinearLayout style="@style/FoodAddTableRow">
                        <TextView
                            style="@style/FoodAddTableLabel"
                            android:text="脂肪" />
                        <FrameLayout style="@style/FoodAddSmallInputWrap">
                            <EditText
                                android:id="@+id/et_fat"
                                style="@style/FoodAddInlineInput"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:paddingEnd="46dp" />
                            <TextView
                                style="@style/FoodAddInputUnit"
                                android:text="g" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/FoodAddDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/FoodAddSectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="脂肪详情" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="单位：g"
                        android:textColor="#222222"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/food_add_table_bg"
                    android:orientation="vertical">

                    <LinearLayout style="@style/FoodAddTableRow">
                        <TextView
                            style="@style/FoodAddTableLabel"
                            android:text="饱和脂肪" />
                        <FrameLayout style="@style/FoodAddSmallInputWrap">
                            <EditText
                                android:id="@+id/et_saturated_fat"
                                style="@style/FoodAddInlineInput"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:paddingEnd="46dp" />
                            <TextView
                                style="@style/FoodAddInputUnit"
                                android:text="g" />
                        </FrameLayout>
                    </LinearLayout>

                    <View style="@style/FoodAddRowDivider" />

                    <LinearLayout style="@style/FoodAddTableRow">
                        <TextView
                            style="@style/FoodAddTableLabel"
                            android:text="单不饱和脂肪" />
                        <FrameLayout style="@style/FoodAddSmallInputWrap">
                            <EditText
                                android:id="@+id/et_mono_unsaturated_fat"
                                style="@style/FoodAddInlineInput"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:paddingEnd="46dp" />
                            <TextView
                                style="@style/FoodAddInputUnit"
                                android:text="g" />
                        </FrameLayout>
                    </LinearLayout>

                    <View style="@style/FoodAddRowDivider" />

                    <LinearLayout style="@style/FoodAddTableRow">
                        <TextView
                            style="@style/FoodAddTableLabel"
                            android:text="多不饱和脂肪" />
                        <FrameLayout style="@style/FoodAddSmallInputWrap">
                            <EditText
                                android:id="@+id/et_poly_unsaturated_fat"
                                style="@style/FoodAddInlineInput"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:paddingEnd="46dp" />
                            <TextView
                                style="@style/FoodAddInputUnit"
                                android:text="g" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/FoodAddDivider" />

                <TextView
                    style="@style/FoodAddSectionTitle"
                    android:text="分类" />

                <RadioGroup
                    android:id="@+id/rg_category"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_category_carb"
                        style="@style/FoodAddSegmentButton"
                        android:text="碳水" />

                    <RadioButton
                        android:id="@+id/rb_category_protein"
                        style="@style/FoodAddSegmentButton"
                        android:layout_marginStart="12dp"
                        android:text="蛋白" />

                    <RadioButton
                        android:id="@+id/rb_category_fat"
                        style="@style/FoodAddSegmentButton"
                        android:layout_marginStart="12dp"
                        android:checked="true"
                        android:text="脂肪" />

                    <RadioButton
                        android:id="@+id/rb_category_fruit"
                        style="@style/FoodAddSegmentButton"
                        android:layout_marginStart="12dp"
                        android:text="水果" />
                </RadioGroup>

                <View style="@style/FoodAddDivider" />

                <TextView
                    style="@style/FoodAddSectionTitle"
                    android:text="计量单位" />

                <RadioGroup
                    android:id="@+id/rg_unit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_gram"
                        style="@style/FoodAddSegmentButton"
                        android:checked="true"
                        android:text="克(g)" />

                    <RadioButton
                        android:id="@+id/rb_milliliter"
                        style="@style/FoodAddSegmentButton"
                        android:layout_marginStart="14dp"
                        android:text="毫升(ml)" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:text="取消"
            android:textColor="#0FA862"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="14dp"
            app:strokeColor="#18B86E"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#19B86C"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
